{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "iOS permission prompt text the system shows when Prairie first asks for this access. Keep it in step with iosApp/iosApp/Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Prairie شبكتك المحلية للعثور على خوادم Prairie، ولإعداد Prairie على التلفزيون والعثور عليه والتحكم فيه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie používá vaši místní síť k vyhledání serverů Prairie a k nastavení, vyhledání a ovládání aplikace Prairie na vaší televizi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie bruger dit lokale netværk til at finde Prairie-servere og til at konfigurere, finde og styre Prairie på dit tv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie verwendet dein lokales Netzwerk, um Prairie-Server zu finden und um Prairie auf deinem Fernseher einzurichten, zu finden und zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie uses your local network to find Prairie servers, and to set up, find, and control Prairie on your TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie usa tu red local para encontrar servidores de Prairie y para configurar, encontrar y controlar Prairie en tu TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie käyttää lähiverkkoasi Prairie-palvelimien löytämiseen sekä Prairien määrittämiseen, löytämiseen ja ohjaamiseen tv:ssäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie utilise votre réseau local pour trouver des serveurs Prairie, et pour configurer, trouver et contrôler Prairie sur votre TV."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie upotrebljava vašu lokalnu mrežu za pronalaženje poslužitelja Prairie te za postavljanje, pronalaženje i upravljanje aplikacijom Prairie na vašem TV-u."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie usa la tua rete locale per trovare i server Prairie e per configurare, trovare e controllare Prairie sulla tua TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairieはローカルネットワークを使用して、Prairieサーバーを検出したり、テレビのPrairieを設定・検出・操作したりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie는 로컬 네트워크를 사용해 Prairie 서버를 찾고, TV에서 Prairie를 설정하고 찾고 제어해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie bruker det lokale nettverket ditt til å finne Prairie-servere og til å konfigurere, finne og styre Prairie på TV-en din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie gebruikt je lokale netwerk om Prairie-servers te vinden, en om Prairie op je tv in te stellen, te vinden en te bedienen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie używa sieci lokalnej do wyszukiwania serwerów Prairie oraz do konfigurowania i wyszukiwania aplikacji Prairie na telewizorze i sterowania nią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Prairie usa sua rede local para encontrar servidores Prairie e para configurar, encontrar e controlar o Prairie na sua TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie использует локальную сеть, чтобы находить серверы Prairie, а также настраивать и находить Prairie на вашем телевизоре и управлять им."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie använder ditt lokala nätverk för att hitta Prairie-servrar och för att konfigurera, hitta och styra Prairie på din tv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie, Prairie sunucularını bulmak ve TV’nizde Prairie’yu kurmak, bulmak ve kontrol etmek için yerel ağınızı kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie використовує вашу локальну мережу, щоб знаходити сервери Prairie, а також налаштовувати й знаходити Prairie на телевізорі та керувати ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie使用你的本地网络查找Prairie服务器，以及在你的电视上设置、查找和控制Prairie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prairie 會使用你的區域網路來尋找 Prairie 伺服器，以及在你的電視上設定、尋找和控制 Prairie。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
