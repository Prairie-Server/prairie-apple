{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "macOS permission prompt text the system shows when Prairie first asks for this access. Keep it in step with iosApp/macOS-Info.plist.",
