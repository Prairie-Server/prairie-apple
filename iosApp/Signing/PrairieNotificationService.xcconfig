// iOS Notification Service extension signing defaults. CI and the paid
// team use these as-is. Local contributors without access to the paid team
// can override any of these by dropping a `Local.xcconfig` into this
// directory.

#include "Shared.xcconfig"

PRAIRIE_NOTIFICATION_SERVICE_BUNDLE_ID = org.prairieserver.prairie.NotificationService
PRAIRIE_NOTIFICATION_SERVICE_ENTITLEMENTS = NotificationService/NotificationService.entitlements

PRODUCT_BUNDLE_IDENTIFIER = $(PRAIRIE_NOTIFICATION_SERVICE_BUNDLE_ID)
CODE_SIGN_ENTITLEMENTS = $(PRAIRIE_NOTIFICATION_SERVICE_ENTITLEMENTS)

#include? "Local.xcconfig"
