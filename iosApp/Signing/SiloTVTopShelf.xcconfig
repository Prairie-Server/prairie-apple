// Top Shelf extension signing defaults. CI and the paid team use these
// as-is. Local contributors without access to the paid team can override
// any of these by dropping a `Local.xcconfig` into this directory — see
// `Local.xcconfig.sample` for the template.
//
// Indirection via `SILO_TOPSHELF_BUNDLE_ID` /
// `SILO_TOPSHELF_ENTITLEMENTS` lets Local.xcconfig swap values
// without touching the other targets' xcconfigs.

SILO_TOPSHELF_BUNDLE_ID = com.continuum.play.topshelf
SILO_TOPSHELF_ENTITLEMENTS = TopShelf/TopShelf.entitlements

PRODUCT_BUNDLE_IDENTIFIER = $(SILO_TOPSHELF_BUNDLE_ID)
CODE_SIGN_ENTITLEMENTS = $(SILO_TOPSHELF_ENTITLEMENTS)

#include? "Local.xcconfig"
